# 1) YouTube Data API v3 key
#    Google Cloud Console > APIs & Services > Credentials > Create credentials > API key
YOUTUBE_API_KEY=

# 2) Gemini API key  (https://aistudio.google.com/api-keys)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_MIN_SECONDS_BETWEEN_CALLS=7

# 3) Google Sheets: the review queue and tracker that Zapier watches
#    Path to the service-account JSON key file, and the ID from the sheet URL:
#    https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json
SHEET_ID=

# 4) Apify API token (optional: Instagram follower counts)
#    Apify Console > Settings > API & Integrations
APIFY_TOKEN=

# 5) Sending
#    test = every email is addressed to TEST_INBOX; the creator's real address is only logged
SEND_MODE=test
TEST_INBOX=your-test-inbox@example.com
#    true = new queue rows are written as "Approved", so Zapier sends without manual review
AUTO_APPROVE=false
